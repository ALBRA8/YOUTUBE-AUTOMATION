# ════════════════════════════════════════════════════════════════════
#  YOUTUBE AUTOMATION v2.0 — Variables de entorno
#  Copia este archivo como "backend/.env" y rellena tus valores.
#     cp backend/.env.example backend/.env
#  ⚠️  El archivo .env NUNCA se sube a Git (está en .gitignore).
# ════════════════════════════════════════════════════════════════════

# ── 🔑 Claves API ────────────────────────────────────────────────────
# Gemini (gratis en https://aistudio.google.com/apikey — empieza con AIzaSy)
# Opcional: sin clave el sistema funciona en modo demo con fallbacks $0.
GEMINI_API_KEY=

# ── 🤖 Modelos Gemini (defaults recomendados) ────────────────────────
# ⚠️ gemini-2.5-flash es un modelo REAL de la API; no inventes nombres aquí
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── 🎙️ Texto a voz ───────────────────────────────────────────────────
# edge   = gratuito e ilimitado (Microsoft Edge TTS)  ← default $0
# gemini = voz premium (Fenrir), consume cuota de tu clave
TTS_PROVIDER=edge
EDGE_TTS_VOICE=es-CO-SalomeNeural
GEMINI_TTS_VOICE=Fenrir
TTS_RATE=+8%

# ── 🗣️ Whisper (alineación palabra a palabra de los subtítulos) ─────
# tiny | base | small | medium   ·   cpu | cuda
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# ── 🎬 Video ─────────────────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
FPS=30

# ── 🏭 Modo fábrica (publicación automática programada) ─────────────
# Horas del día (separadas por coma) en que la fábrica genera videos.
FACTORY_TIMES=07:00,12:30,19:00
FACTORY_TIMEZONE=America/Bogota
FACTORY_NICHE=historias reales impactantes
FACTORY_AUTOPUBLISH=false

# ── 🌐 Servidor ──────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── 🔒 Clave maestra (PRODUCCIÓN — panel expuesto a internet) ────────
# Si defines MASTER_API_KEY, TODAS las rutas /api/* exigirán la clave
# (header X-API-Key, Authorization: Bearer, cookie o ?api_key=).
# El dashboard pedirá la clave con un prompt al cargarla.
# Vacío = modo local abierto (solo recomendado en 127.0.0.1)
#MASTER_API_KEY=

# ── 🛡️ Scopes de la credencial del arnés (opcional, fail-closed) ─────
# Restringe qué permisos youtube.* puede ejercer la credencial del
# arnés (services/youtube_harness/permissions.py). Lista separada por
# comas; vacío o ausente = sin restricción adicional (la frontera es la
# autenticación). Un permiso requerido fuera de esta lista → BLOCKED.
# Catálogo: youtube.read, youtube.production.create,
#           youtube.production.launch, youtube.publish, youtube.destroy
# Ejemplo: credencial de solo-lectura/validación para hosts externos:
#HARNESS_ALLOWED_PERMISSIONS=youtube.read

# ── 📺 OAuth de YouTube (loopback) ───────────────────────────────────
# Google retiró el flujo OOB ("urn:ietf:wg:oauth:2.0:oob") → ahora el
# retorno es un loopback local. Registra ESTA MISMA URI en Google Cloud
# Console → Credenciales → tu OAuth Client → "URIs de redirección":
#   http://127.0.0.1:8000/api/publish/callback
# (cambia el puerto si PORT≠8000, o define otra URI aquí)
#GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/publish/callback

# ── 🎬 Rendimiento / disco ───────────────────────────────────────────
# Renders de video (FFmpeg) que pueden mezclarse a la vez. 1 = el servidor
# nunca se queda sin CPU aunque haya varios proyectos renderizando.
MAX_CONCURRENT_RENDERS=1
# 1 = conserva los clips intermedios tras el render (consume ~100MB/proyecto)
# 0 (default) = los borra automáticamente al terminar el MP4 final
KEEP_INTERMEDIATES=0

# ── 🔌 MCP Connection Manager (INT-022) ─────────────────────────────
# Panel → servidores MCP stdio. Todo opcional: sin definir nada el panel
# muestra hints honestos de qué falta.
# Puerto CDP del Chrome DEDICADO de GoogleFlowMCP (debe coincidir con
# tools/GoogleFlowMCP/src/chrome.js, default 9333; NO uses 9222 del Chrome normal)
#FLOW_CDP_PORT=9333
# GoogleFlowMCP: activa el proveedor y ajusta la ruta si no está en tools/
#FLOW_MCP_ENABLED=1
#FLOW_MCP_DIR=/ruta/a/GoogleFlowMCP
# Comando completo del servidor MCP de NotebookLM (requiere:
#   uv tool install "notebooklm-py[browser]==0.8.5"  →  deja `notebooklm-mcp` en PATH)
#   (pin recomendado 0.8.5: el upstream renombró tools/parámetros entre versiones)
#NOTEBOOKLM_MCP_CMD=notebooklm-mcp
# Carpeta de perfiles de notebooklm-py (vacío = ~/.notebooklm)
#NOTEBOOKLM_HOME=
# notebookId ACTIVO para NotebookLM (fallback si el panel no envía uno; §3)
#NOTEBOOKLM_NOTEBOOK_ID=
# Clave con la que se inyecta el id en los arguments de la tool (default notebook_id)
#NOTEBOOKLM_ID_KEY=notebook_id
# Tool liviana de solo-lectura para el preflight de sesión (default notebook_list)
#NOTEBOOKLM_PROBE_TOOL=notebook_list
# Allowlist opcional coma-separada de tools de NotebookLM. Vacío = todas.
# Ejemplo solo-lectura (nombres v0.8.5): NOTEBOOKLM_MCP_TOOLS=notebook_list,notebook_describe,chat_ask
#NOTEBOOKLM_MCP_TOOLS=
# Timeouts (segundos) por servicio
#NOTEBOOKLM_MCP_TIMEOUT=60
# Timeouts (segundos) de Google Flow (despacho de escenas, INT-023)
#FLOW_MCP_TIMEOUT=120
# ── 🔐 INT-069 · session hardening + 🎬 Studio Bridge ──
# Refresh automático de cookies cuando el preflight detecta AUTH_REQUIRED
# (ejecuta `notebooklm auth refresh --quiet` una vez y reintenta la sonda;
# "0" = desactivado; fail-open).
#NLM_AUTH_REFRESH=1
# NotebookLM Studio Bridge: genera Audio Overview desde el guion y baja el
# audio (.m4a AAC/MP4 en v0.8.5) a exports. "0" = endpoints 404.
#NLM_STUDIO_ENABLED=1
# Carpeta destino de los audios (vacío = backend/data/exports/nlm_studio)
#NLM_STUDIO_EXPORT_DIR=
# Timeout (s) del poll del Audio Overview (el genera tarda minutos)
#NLM_STUDIO_POLL_TIMEOUT=900

# ── 🚀 Pipeline Orchestrator (INT-023) · NotebookLM → Agent → Flow ──
# Tool de solo-lectura del servidor notebooklm-mcp que extrae la bíblia de
# investigación (Stage 1). Debe existir en tools/list del servidor; si no,
# la UI muestra las tools realmente disponibles.
#NOTEBOOKLM_CONTEXT_TOOL=chat_ask
# Consulta enviada junto al notebookId (plantilla editable)
#NOTEBOOKLM_CONTEXT_QUERY=Extrae del notebook la biblia de investigación…
# Máximo de contexto inyectado al generador de guion (protege tokens LLM)
#PIPELINE_CONTEXT_MAX_CHARS=6000
# Asset de referencia compartido: se sube UNA vez y TODAS las escenas lo
# referencian como @{personaje} (consistencia de personaje inter-escena)
#FLOW_REF_ASSET_NAME=personaje
# Ruta a una imagen de referencia existente (vacío = Flow genera el ancla
# del personaje a partir del contexto extraído del notebook)
#FLOW_REF_IMAGE_PATH=

# ── 🎞️ INT-024 — Asset Harvester & FFmpeg Video Assembler (Stage 3.5 + 4) ──
# Duración estimada sin TTS (caracteres de narración por segundo) y suelo
#RENDER_EST_CPS=14.5
#RENDER_MIN_SCENE_SEC=2.0
# Cama musical opcional: ruta absoluta o nombre dentro de backend/data/music/
# (vacío = mezclar sin música). Se atenuará -20dB sobre la narración.
#RENDER_MUSIC_PATH=
#RENDER_MUSIC_DUCK_DB=-20
# Subtítulos: burn (libass) | soft (mov_text) | off
#RENDER_SUBTITLES=burn
# Calidad/timeout del render
#RENDER_FFMPEG_TIMEOUT=900
#RENDER_X264_PRESET=veryfast
#RENDER_CRF=20
# INT-070 (adaptado de estudio-video-ia):
# Ducking dinámico de la cama musical (sidechaincompress: cede cuando habla la voz).
# 0 = ducking fijo -20dB de siempre (default); 1 = sidechain activo.
#RENDER_MUSIC_SIDECAN=0
# Normalización de loudness a -14 LUFS / TP=-1 / LRA=11 (estándar YouTube) tras la mezcla.
# 0 = mezcla sin tocar (default); 1 = loudnorm activo.
#RENDER_LOUDNORM=0
# Realineación de timestamps Whisper contra silencios reales del audio
# (mejora el karaoke palabra-a-palabra junto a las pausas). 1 = activo (default).
#WHISPER_REALIGN=1

# ── 🔑 INT-025 — Sesión Google unificada (google_profile_global) ──
# UN solo login manual humano cubre ambos MCP: el Chrome de login corre con
# este user-data-dir + CDP en GOOGLE_LOGIN_CDP_PORT (= FLOW_CDP_PORT), así
# GoogleFlowMCP hereda la sesión por CDP; y «📥 Capturar sesión» escribe las
# cookies en el storage_state.json de notebooklm-py. Vacío = backend/data/
# google_profile_global
#GOOGLE_PROFILE_GLOBAL=
# URL que abre el Chrome de login (default: chooser de Google con continue
# a NotebookLM)
#GOOGLE_LOGIN_URL=https://accounts.google.com/signinchooser?continue=https%3A%2F%2Fnotebooklm.google.com%2F
# Puerto CDP del Chrome de login (default = FLOW_CDP_PORT → compartido con Flow)
#GOOGLE_LOGIN_CDP_PORT=9333
# Binario Chrome explícito (vacío = autodetección chrome/chromium/edge/brave)
#MCP_LOGIN_CHROME_BIN=
# ── [G] Google One-Tap Hub (INT-071) ──
# URL del botón «Continuar con Google»: el SELECTOR de cuentas con continue a Flow
#GOOGLE_SSO_URL=https://accounts.google.com/AccountChooser?service=lso&continue=https://labs.google/fx/tools/flow
# Poll (s) del watchdog de sesión: cookie __Secure-1PSID/SID vía CDP
#GOOGLE_SSO_POLL_S=2
# Timeout (s) del watchdog si el humano no completa el login (phase=timeout)
#GOOGLE_SSO_TIMEOUT_S=900
# Perfil activo de notebooklm-py (vacío = default; destino de la captura)
#NOTEBOOKLM_PROFILE=

# ── 👄 Lip-Sync HF Spaces $0.00 (INT-072) ────────────────────────────
# Cadena audio-driven REAL (verificada 2026-10-31): KwaiVGI/LivePortrait oficial
# es SOLO video-driven y TMElyralab/MuseTalk está caído → se usa la familia
# EchoMimic/AniPortrait. Orden = prioridad de failover.
AVATAR_HF_ENABLED=1
AVATAR_HF_SPACES=fffiloni/EchoMimic,ZJYang/AniPortrait_official,fffiloni/echomimic-v2
# Timeout por Space (s) — ZeroGPU puede tardar 1-6 min por clip
AVATAR_HF_TIMEOUT_S=420
# Calidad/velocidad: steps bajos = más rápido (menos cuota ZeroGPU)
AVATAR_HF_STEPS=12
# Frames del clip (EchoMimic exige mínimo 100; 100 frames @12fps ≈ 8.3 s)
AVATAR_HF_LENGTH=100
# Token de Hugging Face (GRATIS, https://huggingface.co/settings/tokens):
# sube la cuota ZeroGPU de forma estable. Opcional; sin él puede agotarse.
HF_TOKEN=
# Lienzo final 9:16 (el Space devuelve 512x512 cuadrado → FFmpeg cover+crop)
AVATAR_OUTPUT_W=1080
AVATAR_OUTPUT_H=1920

# ── INT-075 · Lip-sync VIDEO-to-VIDEO (post-procesado de videos de Flow) ──
# El video base de Flow + el audio TTS de la escena → boca sincronizada,
# ANTES del masterizado 9:16. Fail-open: si todo falla sigue el video original.
# Cadena (orden = prioridad). NOTA: ByteDance/LatentSync es GATED — acepta su
# licencia en la página del Space con tu cuenta HF gratis (usa HF_TOKEN de arriba).
AVATAR_V2V_ENABLED=1
AVATAR_V2V_SPACES=ByteDance/LatentSync,akhaliq/Wav2Lip,fffiloni/video-retalking
# Timeout por Space (s)
AVATAR_V2V_TIMEOUT_S=300
# LatentSync inference_steps (mayor = mejor, más lento)
AVATAR_V2V_STEPS=25
