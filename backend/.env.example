# ════════════════════════════════════════════════════════════════════
#  YOUTUBE AUTOMATION v2.0 — Variables de entorno
#  Copia este archivo como "backend/.env" y rellena tus valores.
#     cp backend/.env.example backend/.env
#  ⚠️  El archivo .env NUNCA se sube a Git (está en .gitignore).
# ════════════════════════════════════════════════════════════════════

# ── 🔑 Claves API ────────────────────────────────────────────────────
# Gemini (gratis en https://aistudio.google.com/apikey — empieza con AIzaSy)
# Opcional: sin clave el sistema funciona en modo demo con fallbacks $0.
GEMINI_API_KEY=

# ── 🤖 Modelos Gemini (defaults recomendados) ────────────────────────
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── 🎙️ Texto a voz ───────────────────────────────────────────────────
# edge   = gratuito e ilimitado (Microsoft Edge TTS)  ← default $0
# gemini = voz premium (Fenrir), consume cuota de tu clave
TTS_PROVIDER=edge
EDGE_TTS_VOICE=es-CO-SalomeNeural
GEMINI_TTS_VOICE=Fenrir
TTS_RATE=+8%

# ── 🗣️ Whisper (alineación palabra a palabra de los subtítulos) ─────
# tiny | base | small | medium   ·   cpu | cuda
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# ── 🎬 Video ─────────────────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
FPS=30

# ── 🏭 Modo fábrica (publicación automática programada) ─────────────
# Horas del día (separadas por coma) en que la fábrica genera videos.
FACTORY_TIMES=07:00,12:30,19:00
FACTORY_TIMEZONE=America/Bogota
FACTORY_NICHE=historias reales impactantes
FACTORY_AUTOPUBLISH=false

# ── 🌐 Servidor ──────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
