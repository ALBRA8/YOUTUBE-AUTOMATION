# ════════════════════════════════════════════════════════════════════
#  YOUTUBE AUTOMATION v2.0 — Variables de entorno
#  Copia este archivo como "backend/.env" y rellena tus valores.
#     cp backend/.env.example backend/.env
#  ⚠️  El archivo .env NUNCA se sube a Git (está en .gitignore).
# ════════════════════════════════════════════════════════════════════

# ── 🔑 Claves API ────────────────────────────────────────────────────
# Gemini (gratis en https://aistudio.google.com/apikey — empieza con AIzaSy)
# Opcional: sin clave el sistema funciona en modo demo con fallbacks $0.
GEMINI_API_KEY=

# ── 🤖 Modelos Gemini (defaults recomendados) ────────────────────────
# ⚠️ gemini-2.5-flash es un modelo REAL de la API; no inventes nombres aquí
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── 🎙️ Texto a voz ───────────────────────────────────────────────────
# edge   = gratuito e ilimitado (Microsoft Edge TTS)  ← default $0
# gemini = voz premium (Fenrir), consume cuota de tu clave
TTS_PROVIDER=edge
EDGE_TTS_VOICE=es-CO-SalomeNeural
GEMINI_TTS_VOICE=Fenrir
TTS_RATE=+8%

# ── 🗣️ Whisper (alineación palabra a palabra de los subtítulos) ─────
# tiny | base | small | medium   ·   cpu | cuda
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# ── 🎬 Video ─────────────────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
FPS=30

# ── 🏭 Modo fábrica (publicación automática programada) ─────────────
# Horas del día (separadas por coma) en que la fábrica genera videos.
FACTORY_TIMES=07:00,12:30,19:00
FACTORY_TIMEZONE=America/Bogota
FACTORY_NICHE=historias reales impactantes
FACTORY_AUTOPUBLISH=false

# ── 🌐 Servidor ──────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── 🔒 Clave maestra (PRODUCCIÓN — panel expuesto a internet) ────────
# Si defines MASTER_API_KEY, TODAS las rutas /api/* exigirán la clave
# (header X-API-Key, Authorization: Bearer, cookie o ?api_key=).
# El dashboard pedirá la clave con un prompt al cargarla.
# Vacío = modo local abierto (solo recomendado en 127.0.0.1)
#MASTER_API_KEY=

# ── 🛡️ Scopes de la credencial del arnés (opcional, fail-closed) ─────
# Restringe qué permisos youtube.* puede ejercer la credencial del
# arnés (services/youtube_harness/permissions.py). Lista separada por
# comas; vacío o ausente = sin restricción adicional (la frontera es la
# autenticación). Un permiso requerido fuera de esta lista → BLOCKED.
# Catálogo: youtube.read, youtube.production.create,
#           youtube.production.launch, youtube.publish, youtube.destroy
# Ejemplo: credencial de solo-lectura/validación para hosts externos:
#HARNESS_ALLOWED_PERMISSIONS=youtube.read

# ── 📺 OAuth de YouTube (loopback) ───────────────────────────────────
# Google retiró el flujo OOB ("urn:ietf:wg:oauth:2.0:oob") → ahora el
# retorno es un loopback local. Registra ESTA MISMA URI en Google Cloud
# Console → Credenciales → tu OAuth Client → "URIs de redirección":
#   http://127.0.0.1:8000/api/publish/callback
# (cambia el puerto si PORT≠8000, o define otra URI aquí)
#GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/publish/callback

# ── 🎬 Rendimiento / disco ───────────────────────────────────────────
# Renders de video (FFmpeg) que pueden mezclarse a la vez. 1 = el servidor
# nunca se queda sin CPU aunque haya varios proyectos renderizando.
MAX_CONCURRENT_RENDERS=1
# 1 = conserva los clips intermedios tras el render (consume ~100MB/proyecto)
# 0 (default) = los borra automáticamente al terminar el MP4 final
KEEP_INTERMEDIATES=0

# ── 🔌 MCP Connection Manager (INT-022) ─────────────────────────────
# Panel → servidores MCP stdio. Todo opcional: sin definir nada el panel
# muestra hints honestos de qué falta.
# Puerto CDP del Chrome DEDICADO de GoogleFlowMCP (debe coincidir con
# tools/GoogleFlowMCP/src/chrome.js, default 9333; NO uses 9222 del Chrome normal)
#FLOW_CDP_PORT=9333
# GoogleFlowMCP: activa el proveedor y ajusta la ruta si no está en tools/
#FLOW_MCP_ENABLED=1
#FLOW_MCP_DIR=/ruta/a/GoogleFlowMCP
# Comando completo del servidor MCP de NotebookLM (requiere:
#   uv tool install "notebooklm-py[browser]"  →  deja `notebooklm-mcp` en PATH)
#NOTEBOOKLM_MCP_CMD=notebooklm-mcp
# Carpeta de perfiles de notebooklm-py (vacío = ~/.notebooklm)
#NOTEBOOKLM_HOME=
# notebookId ACTIVO para NotebookLM (fallback si el panel no envía uno; §3)
#NOTEBOOKLM_NOTEBOOK_ID=
# Clave con la que se inyecta el id en los arguments de la tool (default notebook_id)
#NOTEBOOKLM_ID_KEY=notebook_id
# Tool liviana de solo-lectura para el preflight de sesión (default list_notebooks)
#NOTEBOOKLM_PROBE_TOOL=list_notebooks
# Allowlist opcional coma-separada de tools de NotebookLM. Vacío = todas.
# Ejemplo solo-lectura: NOTEBOOKLM_MCP_TOOLS=list_notebooks,get_notebook,query_notebook
#NOTEBOOKLM_MCP_TOOLS=
# Timeouts (segundos) por servicio
#NOTEBOOKLM_MCP_TIMEOUT=60
