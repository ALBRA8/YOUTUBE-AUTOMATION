# X3 · Higiene de finales de línea (ver tests/test_x3_saltos_linea.py)
# Texto versionado: SIEMPRE LF (evita \r\r\n de editores Windows que doblan CR).
# Ojo: .bat/.vbs de launchers/ se quedan FUERA a propósito (los necesita CRLF Windows).

*.py   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.sh   text eol=lf

# Fuentes binarias
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary

# Imágenes binarias
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary

# Audio / video binarios
*.mp3  binary
*.wav  binary
*.m4a  binary
*.mp4  binary
*.mov  binary
*.webm binary

# Otros binarios
*.zip    binary
*.pdf    binary
*.exe    binary
*.dll    binary
*.sqlite binary
*.db     binary
